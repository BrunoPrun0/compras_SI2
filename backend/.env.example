# Copiar a backend/.env y completar. Nunca subir el .env al repo.
PORT=3000

# BD compartida del profesor (credenciales por canal privado del equipo)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=public
DB_SSL=false

# Origen del frontend permitido por CORS
CORS_ORIGIN=http://localhost:5173

# dev: usuario por header X-Empleado-Id (Sprint 2) | jwt: login real con RRHH (Sprint 3+)
AUTH_MODE=dev
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Mapeo de nombres de rol de RRHH a roles internos (JSON). Se completa en Sprint 3.
ROLES_MAP={}

# Cada cuántos minutos se leen recepciones nuevas de log_recepcion
RECEPCIONES_SYNC_MINUTOS=5

# Copiar a backend/.env y completar. Nunca subir el .env al repo.
PORT=3000

# BD compartida del profesor (credenciales por canal privado del equipo)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
# Si la contraseña tiene # o espacios, va entre comillas simples: DB_PASSWORD='...'
DB_PASSWORD=
# Schema propio; los de otros módulos van fijos en sus entidades (inventario, logistica, ...)
DB_SCHEMA=compras
DB_SSL=false
# Conexiones máximas del pool (la BD es compartida: mantenerlo bajo)
DB_POOL_MAX=5

# Origen del frontend permitido por CORS
CORS_ORIGIN=http://localhost:5173

# dev: usuario por header X-Empleado-Id (Sprint 2) | jwt: login real con RRHH (Sprint 3+)
AUTH_MODE=dev
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Mapeo de nombres de rol de RRHH a roles internos (JSON). Se completa en Sprint 3.
ROLES_MAP={}

# Tabla de empleados de RRHH (schema.tabla). RRHH aún no publica rrhh.rrhh_empleado:
# mientras tanto se usa la tabla de prueba de Logística.
RRHH_EMPLEADO_TABLE=logistica.test_log_rrhh_empleado

# Cada cuántos minutos se leen recepciones nuevas de log_recepcion (Logística)
RECEPCIONES_SYNC_MINUTOS=5
# Estados de log_recepcion que no se procesan (separados por coma), p. ej. ANULADA
RECEPCION_ESTADOS_IGNORADOS=

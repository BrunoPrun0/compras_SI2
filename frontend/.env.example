# Copiar a frontend/.env y completar. Nunca subir el .env al repo.

# Ruta de la API; en desarrollo Vite la redirige a http://localhost:3000 (proxy)
VITE_API_URL=/api

# true: usa datos simulados según el contrato (no necesita backend)
VITE_USE_MOCKS=true

# Enlace al dashboard publicado de Power BI (Sprint 4)
VITE_POWERBI_URL=

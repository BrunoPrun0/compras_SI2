# Copiar a frontend/.env y completar. Nunca subir el .env al repo.

# Ruta de la API; en desarrollo Vite la redirige a http://localhost:3000 (proxy)
VITE_API_URL=/api

# Datos simulados sin backend: aún no implementados. Las pantallas usan siempre la API real,
# así que el backend debe estar corriendo (npm run start:dev en backend/).
VITE_USE_MOCKS=false

# Enlace al dashboard publicado de Power BI (Sprint 4)
VITE_POWERBI_URL=

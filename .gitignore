# ==========================================
# Dependencias
# ==========================================
node_modules/
.pnpm-store/
.yarn/*
!.yarn/releases
!.yarn/plugins

# ==========================================
# Builds y salidas compiladas
# ==========================================
dist/
build/
out/
*.tsbuildinfo
.vite/
.turbo/

# ==========================================
# Variables de entorno (NUNCA subir credenciales)
# Se sube solo .env.example como plantilla
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Logs
# ==========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# Tests y cobertura
# ==========================================
coverage/
.nyc_output/
test-results/

# ==========================================
# Base de datos local (Docker / PostgreSQL)
# ==========================================
postgres-data/
pgdata/
*.sql.gz
*.dump
*.backup

# ==========================================
# Editores e IDEs
# ==========================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# ==========================================
# Sistema operativo
# ==========================================
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# Diagramas (respaldos automáticos de draw.io)
# ==========================================
*.drawio.bkp
*.drawio.dtmp
.$*.drawio*

# ==========================================
# Power BI
# Archivos temporales y caché. Los .pbix se versionan
# en docs/powerbi/ si el equipo así lo acuerda.
# ==========================================
*.pbix.bak
.pbi/localSettings.json
.pbi/cache.abf

# ==========================================
# Varios
# ==========================================
*.tmp
.cache/
<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Compras" targetNamespace="http://si2.compras/bpmn" exporter="generado a mano (docs/)" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_Compras">
    <bpmn:participant id="P_Compras" name="Proceso de compras (SC → OC → recepción)" processRef="Process_Compras" />
    <bpmn:participant id="P_Proveedor" name="Proveedor (externo)" />
    <bpmn:messageFlow id="MF_OC" name="OC emitida (documento)" sourceRef="T_EnviarProv" targetRef="P_Proveedor" />
    <bpmn:messageFlow id="MF_Despacho" name="Despacho + guía" sourceRef="P_Proveedor" targetRef="ICE_Llega" />
    <bpmn:messageFlow id="MF_Complemento" name="Entrega complementaria" sourceRef="P_Proveedor" targetRef="ICE_Nueva" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Compras" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Compras">
      <bpmn:lane id="L_SOL" name="Solicitante (todo empleado)">
        <bpmn:flowNodeRef>Start_Necesidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CrearSC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_EditarSC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Borrador</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_AnularBorr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Anulada1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_EnviarSC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RevisarDup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ICE_Anula</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_AnularPend</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Anulada2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_GES" name="Gestor SC (aprobador)">
        <bpmn:flowNodeRef>ICE_Gestor</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RevisarSC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Rechazar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rechazada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Aprobar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_COM" name="Comprador">
        <bpmn:flowNodeRef>T_SelLineas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CrearOC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Oc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CancelarBorr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OcCancel1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_EmitirOC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_EnviarProv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_EsperaOC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ICE_Cancela</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CancelarEmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OcCancel2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ICE_Resuelve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Resolver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Resultado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RegCancelRes</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OcCancel3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_SYS" name="Sistema Compras (backend)">
        <bpmn:flowNodeRef>T_ValidarSC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ValSC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RegPendiente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_EsperaSC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RegAprobada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ValidarOC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ValOC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RegEmitida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Sync</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Conforme</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RegProblemas</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_EsperaProb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RegCompletada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_LOG" name="Logística / Bodega (módulo externo)">
        <bpmn:flowNodeRef>ICE_Llega</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RegRecepcion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ICE_Nueva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Ingreso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Completada</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Necesidad" name="Necesidad de compra">
      <bpmn:outgoing>F_Start_Necesidad__T_CrearSC</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_CrearSC" name="Crear SC [BORRADOR]">
      <bpmn:incoming>F_Start_Necesidad__T_CrearSC</bpmn:incoming>
      <bpmn:outgoing>F_T_CrearSC__T_EditarSC</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_EditarSC" name="Completar motivo y líneas (editable)">
      <bpmn:incoming>F_T_CrearSC__T_EditarSC</bpmn:incoming>
      <bpmn:incoming>F_GW_ValSC__T_EditarSC</bpmn:incoming>
      <bpmn:outgoing>F_T_EditarSC__GW_Borrador</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Borrador" name="¿Qué hace con el borrador?">
      <bpmn:incoming>F_T_EditarSC__GW_Borrador</bpmn:incoming>
      <bpmn:outgoing>F_GW_Borrador__T_AnularBorr</bpmn:outgoing>
      <bpmn:outgoing>F_GW_Borrador__T_EnviarSC</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_AnularBorr" name="Anular SC">
      <bpmn:incoming>F_GW_Borrador__T_AnularBorr</bpmn:incoming>
      <bpmn:outgoing>F_T_AnularBorr__End_Anulada1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Anulada1" name="SC ANULADA">
      <bpmn:incoming>F_T_AnularBorr__End_Anulada1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_EnviarSC" name="Enviar SC">
      <bpmn:incoming>F_GW_Borrador__T_EnviarSC</bpmn:incoming>
      <bpmn:incoming>F_T_RevisarDup__T_EnviarSC</bpmn:incoming>
      <bpmn:outgoing>F_T_EnviarSC__T_ValidarSC</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_ValidarSC" name="Validar envío (V2 campos, V3 duplicados)">
      <bpmn:incoming>F_T_EnviarSC__T_ValidarSC</bpmn:incoming>
      <bpmn:outgoing>F_T_ValidarSC__GW_ValSC</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_ValSC" name="¿Resultado de la validación?">
      <bpmn:incoming>F_T_ValidarSC__GW_ValSC</bpmn:incoming>
      <bpmn:outgoing>F_GW_ValSC__T_EditarSC</bpmn:outgoing>
      <bpmn:outgoing>F_GW_ValSC__T_RevisarDup</bpmn:outgoing>
      <bpmn:outgoing>F_GW_ValSC__T_RegPendiente</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_RevisarDup" name="Revisar SC duplicadas y confirmar">
      <bpmn:incoming>F_GW_ValSC__T_RevisarDup</bpmn:incoming>
      <bpmn:outgoing>F_T_RevisarDup__T_EnviarSC</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_RegPendiente" name="Registrar PENDIENTE + historial">
      <bpmn:incoming>F_GW_ValSC__T_RegPendiente</bpmn:incoming>
      <bpmn:outgoing>F_T_RegPendiente__GW_EsperaSC</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="GW_EsperaSC" name="">
      <bpmn:incoming>F_T_RegPendiente__GW_EsperaSC</bpmn:incoming>
      <bpmn:outgoing>F_GW_EsperaSC__ICE_Anula</bpmn:outgoing>
      <bpmn:outgoing>F_GW_EsperaSC__ICE_Gestor</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="ICE_Anula" name="Solicitante (o ADMIN) decide anular">
      <bpmn:incoming>F_GW_EsperaSC__ICE_Anula</bpmn:incoming>
      <bpmn:outgoing>F_ICE_Anula__T_AnularPend</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CED_ICE_Anula">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">Solicitante (o ADMIN) decide anular</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T_AnularPend" name="Anular SC">
      <bpmn:incoming>F_ICE_Anula__T_AnularPend</bpmn:incoming>
      <bpmn:outgoing>F_T_AnularPend__End_Anulada2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Anulada2" name="SC ANULADA">
      <bpmn:incoming>F_T_AnularPend__End_Anulada2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="ICE_Gestor" name="Gestor toma la SC pendiente">
      <bpmn:incoming>F_GW_EsperaSC__ICE_Gestor</bpmn:incoming>
      <bpmn:outgoing>F_ICE_Gestor__T_RevisarSC</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CED_ICE_Gestor">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">Gestor toma la SC pendiente</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T_RevisarSC" name="Revisar SC (no puede ser propia, V5)">
      <bpmn:incoming>F_ICE_Gestor__T_RevisarSC</bpmn:incoming>
      <bpmn:outgoing>F_T_RevisarSC__GW_Decision</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Decision" name="¿Decisión?">
      <bpmn:incoming>F_T_RevisarSC__GW_Decision</bpmn:incoming>
      <bpmn:outgoing>F_GW_Decision__T_Rechazar</bpmn:outgoing>
      <bpmn:outgoing>F_GW_Decision__T_Aprobar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Rechazar" name="Rechazar con motivo (V4, ≥ 10 caracteres)">
      <bpmn:incoming>F_GW_Decision__T_Rechazar</bpmn:incoming>
      <bpmn:outgoing>F_T_Rechazar__End_Rechazada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Rechazada" name="SC RECHAZADA">
      <bpmn:incoming>F_T_Rechazar__End_Rechazada</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_Aprobar" name="Aprobar SC">
      <bpmn:incoming>F_GW_Decision__T_Aprobar</bpmn:incoming>
      <bpmn:outgoing>F_T_Aprobar__T_RegAprobada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_RegAprobada" name="Registrar APROBADA (id_gestor, fecha_resolucion, historial)">
      <bpmn:incoming>F_T_Aprobar__T_RegAprobada</bpmn:incoming>
      <bpmn:outgoing>F_T_RegAprobada__T_SelLineas</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_SelLineas" name="Seleccionar líneas de SC APROBADA sin OC activa">
      <bpmn:incoming>F_T_RegAprobada__T_SelLineas</bpmn:incoming>
      <bpmn:outgoing>F_T_SelLineas__T_CrearOC</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_CrearOC" name="Crear / editar OC [BORRADOR] (proveedor, cantidades, precios, fecha entrega)">
      <bpmn:incoming>F_T_SelLineas__T_CrearOC</bpmn:incoming>
      <bpmn:incoming>F_GW_ValOC__T_CrearOC</bpmn:incoming>
      <bpmn:outgoing>F_T_CrearOC__GW_Oc</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Oc" name="¿Emitir o cancelar?">
      <bpmn:incoming>F_T_CrearOC__GW_Oc</bpmn:incoming>
      <bpmn:outgoing>F_GW_Oc__T_CancelarBorr</bpmn:outgoing>
      <bpmn:outgoing>F_GW_Oc__T_EmitirOC</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_CancelarBorr" name="Cancelar OC (motivo)">
      <bpmn:incoming>F_GW_Oc__T_CancelarBorr</bpmn:incoming>
      <bpmn:outgoing>F_T_CancelarBorr__End_OcCancel1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_OcCancel1" name="OC CANCELADA">
      <bpmn:incoming>F_T_CancelarBorr__End_OcCancel1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_EmitirOC" name="Emitir OC">
      <bpmn:incoming>F_GW_Oc__T_EmitirOC</bpmn:incoming>
      <bpmn:outgoing>F_T_EmitirOC__T_ValidarOC</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_ValidarOC" name="Validar V7–V10, calcular IVA 19 %">
      <bpmn:incoming>F_T_EmitirOC__T_ValidarOC</bpmn:incoming>
      <bpmn:outgoing>F_T_ValidarOC__GW_ValOC</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_ValOC" name="¿Válida?">
      <bpmn:incoming>F_T_ValidarOC__GW_ValOC</bpmn:incoming>
      <bpmn:outgoing>F_GW_ValOC__T_CrearOC</bpmn:outgoing>
      <bpmn:outgoing>F_GW_ValOC__T_RegEmitida</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_RegEmitida" name="Registrar EMITIDA (en tránsito) + historial">
      <bpmn:incoming>F_GW_ValOC__T_RegEmitida</bpmn:incoming>
      <bpmn:outgoing>F_T_RegEmitida__T_EnviarProv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T_EnviarProv" name="Generar documento OC y enviarla al proveedor">
      <bpmn:incoming>F_T_RegEmitida__T_EnviarProv</bpmn:incoming>
      <bpmn:outgoing>F_T_EnviarProv__GW_EsperaOC</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="GW_EsperaOC" name="">
      <bpmn:incoming>F_T_EnviarProv__GW_EsperaOC</bpmn:incoming>
      <bpmn:outgoing>F_GW_EsperaOC__ICE_Cancela</bpmn:outgoing>
      <bpmn:outgoing>F_GW_EsperaOC__ICE_Llega</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="ICE_Cancela" name="Comprador decide cancelar">
      <bpmn:incoming>F_GW_EsperaOC__ICE_Cancela</bpmn:incoming>
      <bpmn:outgoing>F_ICE_Cancela__T_CancelarEmit</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CED_ICE_Cancela">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">Comprador decide cancelar</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T_CancelarEmit" name="Cancelar OC emitida (motivo)">
      <bpmn:incoming>F_ICE_Cancela__T_CancelarEmit</bpmn:incoming>
      <bpmn:outgoing>F_T_CancelarEmit__End_OcCancel2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_OcCancel2" name="OC CANCELADA">
      <bpmn:incoming>F_T_CancelarEmit__End_OcCancel2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="ICE_Llega" name="Llega mercadería con guía">
      <bpmn:incoming>F_GW_EsperaOC__ICE_Llega</bpmn:incoming>
      <bpmn:outgoing>F_ICE_Llega__T_RegRecepcion</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ICE_Llega" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T_RegRecepcion" name="Registrar recepción y verificar contra guía y OC (log_recepcion)">
      <bpmn:incoming>F_ICE_Llega__T_RegRecepcion</bpmn:incoming>
      <bpmn:incoming>F_ICE_Nueva__T_RegRecepcion</bpmn:incoming>
      <bpmn:outgoing>F_T_RegRecepcion__T_Sync</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T_Sync" name="Sincronizar recepciones y evaluar el acumulado de la OC">
      <bpmn:incoming>F_T_RegRecepcion__T_Sync</bpmn:incoming>
      <bpmn:outgoing>F_T_Sync__GW_Conforme</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Conforme" name="¿Recepción conforme?">
      <bpmn:incoming>F_T_Sync__GW_Conforme</bpmn:incoming>
      <bpmn:outgoing>F_GW_Conforme__T_RegCompletada</bpmn:outgoing>
      <bpmn:outgoing>F_GW_Conforme__T_RegProblemas</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_RegProblemas" name="Registrar CON_PROBLEMAS + diferencias en historial">
      <bpmn:incoming>F_GW_Conforme__T_RegProblemas</bpmn:incoming>
      <bpmn:outgoing>F_T_RegProblemas__GW_EsperaProb</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="GW_EsperaProb" name="">
      <bpmn:incoming>F_T_RegProblemas__GW_EsperaProb</bpmn:incoming>
      <bpmn:outgoing>F_GW_EsperaProb__ICE_Nueva</bpmn:outgoing>
      <bpmn:outgoing>F_GW_EsperaProb__ICE_Resuelve</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="ICE_Nueva" name="Llega entrega complementaria">
      <bpmn:incoming>F_GW_EsperaProb__ICE_Nueva</bpmn:incoming>
      <bpmn:outgoing>F_ICE_Nueva__T_RegRecepcion</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ICE_Nueva" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="ICE_Resuelve" name="Comprador decide resolver">
      <bpmn:incoming>F_GW_EsperaProb__ICE_Resuelve</bpmn:incoming>
      <bpmn:outgoing>F_ICE_Resuelve__T_Resolver</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="CED_ICE_Resuelve">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">Comprador decide resolver</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T_Resolver" name="Resolver OC con problemas (resultado + comentario)">
      <bpmn:incoming>F_ICE_Resuelve__T_Resolver</bpmn:incoming>
      <bpmn:outgoing>F_T_Resolver__GW_Resultado</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Resultado" name="¿Resultado?">
      <bpmn:incoming>F_T_Resolver__GW_Resultado</bpmn:incoming>
      <bpmn:outgoing>F_GW_Resultado__T_RegCancelRes</bpmn:outgoing>
      <bpmn:outgoing>F_GW_Resultado__T_RegCompletada</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_RegCancelRes" name="Registrar CANCELADA + comentario">
      <bpmn:incoming>F_GW_Resultado__T_RegCancelRes</bpmn:incoming>
      <bpmn:outgoing>F_T_RegCancelRes__End_OcCancel3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_OcCancel3" name="OC CANCELADA">
      <bpmn:incoming>F_T_RegCancelRes__End_OcCancel3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_RegCompletada" name="Registrar COMPLETADA + fecha_recepcion_real">
      <bpmn:incoming>F_GW_Conforme__T_RegCompletada</bpmn:incoming>
      <bpmn:incoming>F_GW_Resultado__T_RegCompletada</bpmn:incoming>
      <bpmn:outgoing>F_T_RegCompletada__T_Ingreso</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Ingreso" name="Confirmar ingreso a Inventario (inv_movimiento)">
      <bpmn:incoming>F_T_RegCompletada__T_Ingreso</bpmn:incoming>
      <bpmn:outgoing>F_T_Ingreso__End_Completada</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Completada" name="OC COMPLETADA">
      <bpmn:incoming>F_T_Ingreso__End_Completada</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_Start_Necesidad__T_CrearSC" sourceRef="Start_Necesidad" targetRef="T_CrearSC" />

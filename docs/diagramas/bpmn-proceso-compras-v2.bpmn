    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Inv" name="Stock actualizado">
      <bpmn:incoming>F_T_ActStock__End_Inv</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_Start_Ingreso__T_ActStock" sourceRef="Start_Ingreso" targetRef="T_ActStock" />
    <bpmn:sequenceFlow id="F_T_ActStock__End_Inv" sourceRef="T_ActStock" targetRef="End_Inv" />
  </bpmn:process>

  <bpmn:process id="Proc_Logistica" isExecutable="false">
    <bpmn:startEvent id="Start_Despacho" name="Despacho recibido con guía">
      <bpmn:outgoing>F_Start_Despacho__T_Verificar</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_Despacho_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="T_Verificar" name="Verificar mercadería contra guía y OC">
      <bpmn:incoming>F_Start_Despacho__T_Verificar</bpmn:incoming>
      <bpmn:outgoing>F_T_Verificar__T_RegRec</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_RegRec" name="Registrar cantidades recibidas y dañadas">
      <bpmn:incoming>F_T_Verificar__T_RegRec</bpmn:incoming>
      <bpmn:outgoing>F_T_RegRec__T_ConfIng</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="T_ConfIng" name="Confirmar ingreso a Inventario">
      <bpmn:incoming>F_T_RegRec__T_ConfIng</bpmn:incoming>
      <bpmn:outgoing>F_T_ConfIng__End_Log</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_Log" name="Recepción cerrada">
      <bpmn:incoming>F_T_ConfIng__End_Log</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_Start_Despacho__T_Verificar" sourceRef="Start_Despacho" targetRef="T_Verificar" />
    <bpmn:sequenceFlow id="F_T_Verificar__T_RegRec" sourceRef="T_Verificar" targetRef="T_RegRec" />
    <bpmn:sequenceFlow id="F_T_RegRec__T_ConfIng" sourceRef="T_RegRec" targetRef="T_ConfIng" />
    <bpmn:sequenceFlow id="F_T_ConfIng__End_Log" sourceRef="T_ConfIng" targetRef="End_Log" />
  </bpmn:process>
  <bpmn:process id="Proc_Inventario" isExecutable="false">

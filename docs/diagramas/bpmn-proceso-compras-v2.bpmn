<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_ProcesoCompras" targetNamespace="http://lesgo.cl/bpmn/compras" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="17.11.1">
  <bpmn:collaboration id="Collab_Compras">
    <bpmn:participant id="P_Compras" name="LESGO · Compras" processRef="Proc_Compras" />
    <bpmn:participant id="P_Proveedor" name="Proveedor" />
    <bpmn:participant id="P_Logistica" name="LESGO · Logística" processRef="Proc_Logistica" />
    <bpmn:participant id="P_Inventario" name="LESGO · Inventario" processRef="Proc_Inventario" />
    <bpmn:messageFlow id="MF_OC" name="Orden de compra" sourceRef="T_EnviarProv" targetRef="P_Proveedor" />
    <bpmn:messageFlow id="MF_NoDesp" name="Aviso de no despacho" sourceRef="P_Proveedor" targetRef="ICE_NoDesp" />
    <bpmn:messageFlow id="MF_Despacho" name="Mercadería y guía de despacho" sourceRef="P_Proveedor" targetRef="Start_Despacho" />
    <bpmn:messageFlow id="MF_Rec" name="Recepción registrada" sourceRef="T_RegRec" targetRef="ICE_Rec" />
    <bpmn:messageFlow id="MF_Rec2" name="Recepción de la reposición" sourceRef="T_RegRec" targetRef="ICE_Nueva" />
    <bpmn:messageFlow id="MF_Ingreso" name="Ingreso de mercadería" sourceRef="T_ConfIng" targetRef="Start_Ingreso" />
    <bpmn:textAnnotation id="Ann_Pend"><bpmn:text>Mientras la SC está pendiente, el solicitante aún puede anularla. El gestor nunca resuelve una SC propia.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Ann_Pend_assoc" associationDirection="None" sourceRef="Ann_Pend" targetRef="T_Revisar" />
    <bpmn:textAnnotation id="Ann_OC"><bpmn:text>Cada SC aprobada se convierte en una OC. Una OC también puede agrupar líneas de varias SC aprobadas; cada línea conserva su SC de origen.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Ann_OC_assoc" associationDirection="None" sourceRef="Ann_OC" targetRef="T_ArmarOC" />
    <bpmn:textAnnotation id="Ann_Conf"><bpmn:text>Conforme: sumando todas las entregas, lo recibido iguala lo pedido, sin productos dañados ni de más.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Ann_Conf_assoc" associationDirection="None" sourceRef="Ann_Conf" targetRef="T_Comparar" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Compras" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Compras">
      <bpmn:lane id="L_Solicitante" name="Solicitante (cualquier área)">
        <bpmn:flowNodeRef>Start_Necesidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_EnvAnul</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_AnulBorr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Validar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RevDup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Mant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RegPend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Gestor" name="Gestor de solicitudes">
        <bpmn:flowNodeRef>T_Revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Aprobar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Rechazar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rech</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Aprobar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Comprador" name="Comprador">
        <bpmn:flowNodeRef>GW_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ArmarOC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_EmCan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OcCanc1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ValidarOC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ValOC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RegEmit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_EnviarProv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EBG_OC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ICE_NoDesp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_CancelarOC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OcCanc2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ICE_Rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Comparar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Conf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RegProb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Definir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Res</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ICE_Nueva</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OcCanc3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_M5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_RegComp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Comp</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Necesidad" name="Necesidad de sets">
      <bpmn:outgoing>F_Start_Necesidad__GW_M1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="GW_M1">
      <bpmn:incoming>F_Start_Necesidad__GW_M1</bpmn:incoming>
      <bpmn:incoming>F_GW_Val__GW_M1</bpmn:incoming>
      <bpmn:incoming>F_GW_Mant__GW_M1</bpmn:incoming>
      <bpmn:outgoing>F_GW_M1__T_Registrar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Registrar" name="Registrar SC: motivo, productos y cantidades">
      <bpmn:incoming>F_GW_M1__T_Registrar</bpmn:incoming>
      <bpmn:outgoing>F_T_Registrar__GW_EnvAnul</bpmn:outgoing>
      <bpmn:property id="T_Registrar_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DIA_Catalogo"><bpmn:sourceRef>DS_Catalogo</bpmn:sourceRef><bpmn:targetRef>T_Registrar_prop</bpmn:targetRef></bpmn:dataInputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_EnvAnul" name="¿Enviar o anular?">
      <bpmn:incoming>F_T_Registrar__GW_EnvAnul</bpmn:incoming>
      <bpmn:outgoing>F_GW_EnvAnul__End_AnulBorr</bpmn:outgoing>
      <bpmn:outgoing>F_GW_EnvAnul__T_Validar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_AnulBorr" name="SC anulada">
      <bpmn:incoming>F_GW_EnvAnul__End_AnulBorr</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_Validar" name="Validar SC: datos obligatorios y duplicados">
      <bpmn:incoming>F_GW_EnvAnul__T_Validar</bpmn:incoming>
      <bpmn:outgoing>F_T_Validar__GW_Val</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Val" name="¿SC completa y sin duplicados?">
      <bpmn:incoming>F_T_Validar__GW_Val</bpmn:incoming>
      <bpmn:outgoing>F_GW_Val__GW_M1</bpmn:outgoing>
      <bpmn:outgoing>F_GW_Val__T_RevDup</bpmn:outgoing>
      <bpmn:outgoing>F_GW_Val__GW_MP</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_RevDup" name="Revisar SC que piden el mismo producto">
      <bpmn:incoming>F_GW_Val__T_RevDup</bpmn:incoming>
      <bpmn:outgoing>F_T_RevDup__GW_Mant</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Mant" name="¿Se mantiene la SC?">
      <bpmn:incoming>F_T_RevDup__GW_Mant</bpmn:incoming>
      <bpmn:outgoing>F_GW_Mant__GW_MP</bpmn:outgoing>
      <bpmn:outgoing>F_GW_Mant__GW_M1</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_MP">
      <bpmn:incoming>F_GW_Val__GW_MP</bpmn:incoming>
      <bpmn:incoming>F_GW_Mant__GW_MP</bpmn:incoming>
      <bpmn:outgoing>F_GW_MP__T_RegPend</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_RegPend" name="Registrar SC pendiente">
      <bpmn:incoming>F_GW_MP__T_RegPend</bpmn:incoming>
      <bpmn:outgoing>F_T_RegPend__T_Revisar</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Revisar" name="Revisar SC">
      <bpmn:incoming>F_T_RegPend__T_Revisar</bpmn:incoming>
      <bpmn:outgoing>F_T_Revisar__GW_Aprobar</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Aprobar" name="¿Aprobar SC?">
      <bpmn:incoming>F_T_Revisar__GW_Aprobar</bpmn:incoming>
      <bpmn:outgoing>F_GW_Aprobar__T_Rechazar</bpmn:outgoing>
      <bpmn:outgoing>F_GW_Aprobar__T_Aprobar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Rechazar" name="Rechazar SC indicando motivo">
      <bpmn:incoming>F_GW_Aprobar__T_Rechazar</bpmn:incoming>
      <bpmn:outgoing>F_T_Rechazar__End_Rech</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_Rech" name="SC rechazada">
      <bpmn:incoming>F_T_Rechazar__End_Rech</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_Aprobar" name="Aprobar SC">
      <bpmn:incoming>F_GW_Aprobar__T_Aprobar</bpmn:incoming>
      <bpmn:outgoing>F_T_Aprobar__GW_M3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_M3">
      <bpmn:incoming>F_T_Aprobar__GW_M3</bpmn:incoming>
      <bpmn:incoming>F_GW_ValOC__GW_M3</bpmn:incoming>
      <bpmn:outgoing>F_GW_M3__T_ArmarOC</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_ArmarOC" name="Armar OC: proveedor, cantidades, precios y fecha comprometida">
      <bpmn:incoming>F_GW_M3__T_ArmarOC</bpmn:incoming>
      <bpmn:outgoing>F_T_ArmarOC__GW_EmCan</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_EmCan" name="¿Emitir o cancelar?">
      <bpmn:incoming>F_T_ArmarOC__GW_EmCan</bpmn:incoming>
      <bpmn:outgoing>F_GW_EmCan__End_OcCanc1</bpmn:outgoing>
      <bpmn:outgoing>F_GW_EmCan__T_ValidarOC</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_OcCanc1" name="OC cancelada">
      <bpmn:incoming>F_GW_EmCan__End_OcCanc1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="T_ValidarOC" name="Validar OC y calcular totales">
      <bpmn:incoming>F_GW_EmCan__T_ValidarOC</bpmn:incoming>
      <bpmn:outgoing>F_T_ValidarOC__GW_ValOC</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_ValOC" name="¿OC válida?">
      <bpmn:incoming>F_T_ValidarOC__GW_ValOC</bpmn:incoming>
      <bpmn:outgoing>F_GW_ValOC__GW_M3</bpmn:outgoing>
      <bpmn:outgoing>F_GW_ValOC__T_RegEmit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_RegEmit" name="Registrar OC emitida">
      <bpmn:incoming>F_GW_ValOC__T_RegEmit</bpmn:incoming>
      <bpmn:outgoing>F_T_RegEmit__T_EnviarProv</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="T_EnviarProv" name="Enviar OC al proveedor">
      <bpmn:incoming>F_T_RegEmit__T_EnviarProv</bpmn:incoming>
      <bpmn:outgoing>F_T_EnviarProv__EBG_OC</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="EBG_OC">
      <bpmn:incoming>F_T_EnviarProv__EBG_OC</bpmn:incoming>
      <bpmn:outgoing>F_EBG_OC__ICE_NoDesp</bpmn:outgoing>
      <bpmn:outgoing>F_EBG_OC__ICE_Rec</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="ICE_NoDesp" name="Proveedor no despachará">
      <bpmn:incoming>F_EBG_OC__ICE_NoDesp</bpmn:incoming>
      <bpmn:outgoing>F_ICE_NoDesp__T_CancelarOC</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ICE_NoDesp_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T_CancelarOC" name="Cancelar OC indicando motivo">
      <bpmn:incoming>F_ICE_NoDesp__T_CancelarOC</bpmn:incoming>
      <bpmn:outgoing>F_T_CancelarOC__End_OcCanc2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_OcCanc2" name="OC cancelada">
      <bpmn:incoming>F_T_CancelarOC__End_OcCanc2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="ICE_Rec" name="Recepción registrada">
      <bpmn:incoming>F_EBG_OC__ICE_Rec</bpmn:incoming>
      <bpmn:outgoing>F_ICE_Rec__GW_M4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ICE_Rec_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="GW_M4">
      <bpmn:incoming>F_ICE_Rec__GW_M4</bpmn:incoming>
      <bpmn:incoming>F_ICE_Nueva__GW_M4</bpmn:incoming>
      <bpmn:outgoing>F_GW_M4__T_Comparar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Comparar" name="Comparar lo recibido con lo pedido">
      <bpmn:incoming>F_GW_M4__T_Comparar</bpmn:incoming>
      <bpmn:outgoing>F_T_Comparar__GW_Conf</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Conf" name="¿Recepción conforme?">
      <bpmn:incoming>F_T_Comparar__GW_Conf</bpmn:incoming>
      <bpmn:outgoing>F_GW_Conf__GW_M5</bpmn:outgoing>
      <bpmn:outgoing>F_GW_Conf__T_RegProb</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_RegProb" name="Registrar OC con problemas">
      <bpmn:incoming>F_GW_Conf__T_RegProb</bpmn:incoming>
      <bpmn:outgoing>F_T_RegProb__T_Definir</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Definir" name="Definir solución para las diferencias">
      <bpmn:incoming>F_T_RegProb__T_Definir</bpmn:incoming>
      <bpmn:outgoing>F_T_Definir__GW_Res</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Res" name="¿Cómo se resuelve?">
      <bpmn:incoming>F_T_Definir__GW_Res</bpmn:incoming>
      <bpmn:outgoing>F_GW_Res__GW_M5</bpmn:outgoing>
      <bpmn:outgoing>F_GW_Res__End_OcCanc3</bpmn:outgoing>
      <bpmn:outgoing>F_GW_Res__ICE_Nueva</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="ICE_Nueva" name="Reposición recibida">
      <bpmn:incoming>F_GW_Res__ICE_Nueva</bpmn:incoming>
      <bpmn:outgoing>F_ICE_Nueva__GW_M4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="ICE_Nueva_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_OcCanc3" name="OC cancelada">
      <bpmn:incoming>F_GW_Res__End_OcCanc3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GW_M5">
      <bpmn:incoming>F_GW_Conf__GW_M5</bpmn:incoming>
      <bpmn:incoming>F_GW_Res__GW_M5</bpmn:incoming>
      <bpmn:outgoing>F_GW_M5__T_RegComp</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_RegComp" name="Registrar OC completada y fecha de recepción">
      <bpmn:incoming>F_GW_M5__T_RegComp</bpmn:incoming>
      <bpmn:outgoing>F_T_RegComp__End_Comp</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_Comp" name="OC completada">
      <bpmn:incoming>F_T_RegComp__End_Comp</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_Start_Necesidad__GW_M1" sourceRef="Start_Necesidad" targetRef="GW_M1" />
    <bpmn:sequenceFlow id="F_GW_M1__T_Registrar" sourceRef="GW_M1" targetRef="T_Registrar" />
    <bpmn:sequenceFlow id="F_T_Registrar__GW_EnvAnul" sourceRef="T_Registrar" targetRef="GW_EnvAnul" />
    <bpmn:sequenceFlow id="F_GW_EnvAnul__End_AnulBorr" name="Anular" sourceRef="GW_EnvAnul" targetRef="End_AnulBorr" />
    <bpmn:sequenceFlow id="F_GW_EnvAnul__T_Validar" name="Enviar" sourceRef="GW_EnvAnul" targetRef="T_Validar" />
    <bpmn:sequenceFlow id="F_T_Validar__GW_Val" sourceRef="T_Validar" targetRef="GW_Val" />
    <bpmn:sequenceFlow id="F_GW_Val__GW_M1" name="Faltan datos" sourceRef="GW_Val" targetRef="GW_M1" />
    <bpmn:sequenceFlow id="F_GW_Val__T_RevDup" name="Posible duplicado" sourceRef="GW_Val" targetRef="T_RevDup" />
    <bpmn:sequenceFlow id="F_GW_Val__GW_MP" name="Sí" sourceRef="GW_Val" targetRef="GW_MP" />
    <bpmn:sequenceFlow id="F_T_RevDup__GW_Mant" sourceRef="T_RevDup" targetRef="GW_Mant" />
    <bpmn:sequenceFlow id="F_GW_Mant__GW_MP" name="Sí" sourceRef="GW_Mant" targetRef="GW_MP" />
    <bpmn:sequenceFlow id="F_GW_Mant__GW_M1" name="No, se corrige" sourceRef="GW_Mant" targetRef="GW_M1" />
    <bpmn:sequenceFlow id="F_GW_MP__T_RegPend" sourceRef="GW_MP" targetRef="T_RegPend" />
    <bpmn:sequenceFlow id="F_T_RegPend__T_Revisar" sourceRef="T_RegPend" targetRef="T_Revisar" />
    <bpmn:sequenceFlow id="F_T_Revisar__GW_Aprobar" sourceRef="T_Revisar" targetRef="GW_Aprobar" />
    <bpmn:sequenceFlow id="F_GW_Aprobar__T_Rechazar" name="No" sourceRef="GW_Aprobar" targetRef="T_Rechazar" />
    <bpmn:sequenceFlow id="F_T_Rechazar__End_Rech" sourceRef="T_Rechazar" targetRef="End_Rech" />
    <bpmn:sequenceFlow id="F_GW_Aprobar__T_Aprobar" name="Sí" sourceRef="GW_Aprobar" targetRef="T_Aprobar" />
    <bpmn:sequenceFlow id="F_T_Aprobar__GW_M3" sourceRef="T_Aprobar" targetRef="GW_M3" />
    <bpmn:sequenceFlow id="F_GW_M3__T_ArmarOC" sourceRef="GW_M3" targetRef="T_ArmarOC" />
    <bpmn:sequenceFlow id="F_T_ArmarOC__GW_EmCan" sourceRef="T_ArmarOC" targetRef="GW_EmCan" />
    <bpmn:sequenceFlow id="F_GW_EmCan__End_OcCanc1" name="Cancelar" sourceRef="GW_EmCan" targetRef="End_OcCanc1" />
    <bpmn:sequenceFlow id="F_GW_EmCan__T_ValidarOC" name="Emitir" sourceRef="GW_EmCan" targetRef="T_ValidarOC" />
    <bpmn:sequenceFlow id="F_T_ValidarOC__GW_ValOC" sourceRef="T_ValidarOC" targetRef="GW_ValOC" />
    <bpmn:sequenceFlow id="F_GW_ValOC__GW_M3" name="No" sourceRef="GW_ValOC" targetRef="GW_M3" />
    <bpmn:sequenceFlow id="F_GW_ValOC__T_RegEmit" name="Sí" sourceRef="GW_ValOC" targetRef="T_RegEmit" />
    <bpmn:sequenceFlow id="F_T_RegEmit__T_EnviarProv" sourceRef="T_RegEmit" targetRef="T_EnviarProv" />
    <bpmn:sequenceFlow id="F_T_EnviarProv__EBG_OC" sourceRef="T_EnviarProv" targetRef="EBG_OC" />
    <bpmn:sequenceFlow id="F_EBG_OC__ICE_NoDesp" sourceRef="EBG_OC" targetRef="ICE_NoDesp" />
    <bpmn:sequenceFlow id="F_ICE_NoDesp__T_CancelarOC" sourceRef="ICE_NoDesp" targetRef="T_CancelarOC" />
    <bpmn:sequenceFlow id="F_T_CancelarOC__End_OcCanc2" sourceRef="T_CancelarOC" targetRef="End_OcCanc2" />
    <bpmn:sequenceFlow id="F_EBG_OC__ICE_Rec" sourceRef="EBG_OC" targetRef="ICE_Rec" />
    <bpmn:sequenceFlow id="F_ICE_Rec__GW_M4" sourceRef="ICE_Rec" targetRef="GW_M4" />
    <bpmn:sequenceFlow id="F_GW_M4__T_Comparar" sourceRef="GW_M4" targetRef="T_Comparar" />
